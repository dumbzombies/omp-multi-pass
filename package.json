{
  "name": "omp-multi-pass",
  "version": "1.2.0",
  "description": "Multi-subscription extension for oh-my-pi (omp) -- use multiple OAuth accounts per provider (Anthropic, Codex, Copilot, Gemini, Antigravity, Gemini App)",
  "keywords": [
    "omp-package",
    "omp-extension",
    "oh-my-pi",
    "pi-package",
    "pi-extension",
    "multi-subscription",
    "oauth",
    "codex",
    "anthropic",
    "copilot",
    "gemini-app",
    "clinepass",
    "commandcode"
  ],
  "license": "MIT",
  "type": "module",
  "author": "omp-multi-pass contributors (fork of hjanuschka/pi-multi-pass)",
  "contributors": [
    "hjanuschka (pi-multi-pass)",
    "ShawTim (gemini-app2api / pi-gemini-app)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dumbzombies/omp-multi-pass"
  },
  "homepage": "https://github.com/dumbzombies/omp-multi-pass",
  "bugs": {
    "url": "https://github.com/dumbzombies/omp-multi-pass/issues"
  },
  "files": [
    "extensions",
    "lib",
    "docs",
    "vendor",
    "README.md",
    "NOTICE"
  ],
  "pi": {
    "extensions": [
      "./extensions",
      "./vendor/gemini-app2api/extensions/pi/index.js",
      "./vendor/clinepass/src/index.ts",
      "./vendor/commandcode/index.ts"
    ]
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2"
  }
}
